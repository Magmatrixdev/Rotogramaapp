{
  "rules": {

    // ─────────────────────────────────────────────────────────────
    // RAIZ  → tudo negado por padrão
    // ─────────────────────────────────────────────────────────────
    ".read":  false,
    ".write": false,

    // ─────────────────────────────────────────────────────────────
    // /motoristas
    //   • Listagem da coleção: apenas admin (claim admin===true)
    //   • Nó individual:       admin  OU  próprio uid
    //   • Escrita:             apenas admin (ou Cloud Functions via Admin SDK)
    //   • .indexOn cpfHmac:   necessário para query orderByChild nas funções
    // ─────────────────────────────────────────────────────────────
    "motoristas": {
      ".read":  "auth !== null && auth.token.admin === true",
      ".write": "auth !== null && auth.token.admin === true",
      ".indexOn": ["cpfHmac"],

      "$id": {
        ".read":  "auth !== null && (auth.token.admin === true || auth.uid === $id)",
        ".write": "auth !== null && auth.token.admin === true",

        ".validate": "newData.hasChildren(['nome', 'cpfHmac', 'pinHash', 'pinSalt'])",

        "nome": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100"
        },
        "cpfHmac": {
          // HMAC-SHA256 do CPF — 64 hex chars; nunca armazena CPF em claro
          ".validate": "newData.isString() && newData.val().length === 64"
        },
        "pinHash": {
          // Hash scrypt do PIN — 128 hex chars (64 bytes)
          ".validate": "newData.isString() && newData.val().length === 128"
        },
        "pinSalt": {
          // Salt aleatório — 32 hex chars (16 bytes)
          ".validate": "newData.isString() && newData.val().length === 32"
        },
        "pinResetRequired": {
          ".validate": "newData.isBoolean()"
        },
        "bloqueado": {
          ".validate": "newData.isBoolean()"
        },
        "criadoEm": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "ultimoAcesso": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "migradoEm": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "migradoDe": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        // bloqueia campos não declarados
        "$outrosCampos": { ".validate": false }
      }
    },

    // ─────────────────────────────────────────────────────────────
    // /motoristas-secure
    //   • CPF cifrado com AES-256-GCM (chave no Secret Manager)
    //   • Clientes NUNCA leem/escrevem — apenas Cloud Functions via Admin SDK
    //   • .read/.write false garante que as regras bloqueiam qualquer acesso
    //     de client SDK; Admin SDK as bypassa intencionalmente.
    // ─────────────────────────────────────────────────────────────
    "motoristas-secure": {
      ".read":  false,
      ".write": false
    },

    // ─────────────────────────────────────────────────────────────
    // /rateLimits
    //   • Contadores de tentativas de login por cpfHmac
    //   • Gerenciados exclusivamente pelas Cloud Functions
    // ─────────────────────────────────────────────────────────────
    "rateLimits": {
      ".read":  false,
      ".write": false
    },

    // ─────────────────────────────────────────────────────────────
    // /audit
    //   • Log de auditoria: quem pediu getDriverCPF, setAdminClaim, etc.
    //   • Escrito apenas pelas Cloud Functions (Admin SDK)
    //   • Leitura: apenas admin
    // ─────────────────────────────────────────────────────────────
    "audit": {
      ".read":  "auth !== null && auth.token.admin === true",
      ".write": false,

      "$uid": {
        "$entry": {
          ".validate": "newData.hasChildren(['action', 'byUid', 'ts'])",
          "action": { ".validate": "newData.isString() && newData.val().length <= 50" },
          "byUid":  { ".validate": "newData.isString() && newData.val().length <= 128" },
          "ts":     { ".validate": "newData.isNumber() && newData.val() > 0" },
          "$outrosCampos": { ".validate": false }
        }
      }
    },

    // ─────────────────────────────────────────────────────────────
    // /viagens
    //   • Listagem da coleção: apenas admin
    //   • Nó individual:  admin  OU  motorista dono (motoristaId === uid)
    //   • Criação:        admin  OU  motorista autenticado (motoristaId deve === uid)
    //   • Atualização:    admin  OU  motorista dono
    // ─────────────────────────────────────────────────────────────
    "viagens": {
      ".read":  "auth !== null && auth.token.admin === true",

      "$viagemId": {
        ".read": "auth !== null && (auth.token.admin === true || data.child('motoristaId').val() === auth.uid)",
        ".write": "auth !== null && (auth.token.admin === true || newData.child('motoristaId').val() === auth.uid)",

        ".validate": "newData.hasChildren(['motoristaId', 'status', 'dataInicio'])",

        "motoristaId": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
        },
        "dataInicio": {
          ".validate": "newData.isString() && newData.val().length <= 30 || newData.isNumber()"
        },
        "dataFim": {
          ".validate": "newData.isString() && newData.val().length <= 30 || newData.isNumber()"
        },
        "rotogramaId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "postoOrigemId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "postoDestinoId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "observacoes": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "km": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "$outrosCampos": { ".validate": false }
      }
    },

    // ─────────────────────────────────────────────────────────────
    // /posicoes/$id   (id === uid do motorista)
    //   • Escrita: apenas o próprio motorista (auth.uid === $id)
    //   • Leitura: apenas admin
    // ─────────────────────────────────────────────────────────────
    "posicoes": {
      ".read":  "auth !== null && auth.token.admin === true",
      ".write": false,

      "$id": {
        ".read":  "auth !== null && auth.token.admin === true",
        ".write": "auth !== null && auth.uid === $id",

        ".validate": "newData.hasChildren(['lat', 'lng', 'ts'])",

        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "velocidade": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 350"
        },
        "precisao": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "viagemId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "$outrosCampos": { ".validate": false }
      }
    },

    // ─────────────────────────────────────────────────────────────
    // /rotogramas
    //   • Leitura: qualquer usuário autenticado
    //   • Escrita: apenas admin
    // ─────────────────────────────────────────────────────────────
    "rotogramas": {
      ".read":  "auth !== null",
      ".write": "auth !== null && auth.token.admin === true",

      "$rotId": {
        ".validate": "newData.hasChildren(['titulo'])",

        "titulo": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
        },
        "descricao": {
          ".validate": "newData.isString() && newData.val().length <= 3000"
        },
        "ativo": {
          ".validate": "newData.isBoolean()"
        },
        "versao": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "totalKm": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "postos": {
          "$postoRef": {
            ".validate": "newData.isString() && newData.val().length <= 128 || newData.isBoolean()"
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "$outrosCampos": { ".validate": false }
      }
    },

    // ─────────────────────────────────────────────────────────────
    // /postos
    //   • Leitura: qualquer usuário autenticado
    //   • Escrita: apenas admin
    // ─────────────────────────────────────────────────────────────
    "postos": {
      ".read":  "auth !== null",
      ".write": "auth !== null && auth.token.admin === true",

      "$postoId": {
        ".validate": "newData.hasChildren(['nome'])",

        "nome": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
        },
        "endereco": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "cidade": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "estado": {
          ".validate": "newData.isString() && newData.val().length === 2"
        },
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        "ativo": {
          ".validate": "newData.isBoolean()"
        },
        "telefone": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "$outrosCampos": { ".validate": false }
      }
    },

    // ─────────────────────────────────────────────────────────────
    // /notifications
    //   • Leitura: qualquer usuário autenticado
    //   • Escrita: apenas admin
    // ─────────────────────────────────────────────────────────────
    "notifications": {
      ".read":  "auth !== null",
      ".write": "auth !== null && auth.token.admin === true",

      "$notifId": {
        ".validate": "newData.hasChildren(['mensagem', 'ts'])",

        "mensagem": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
        },
        "titulo": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "tipo": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "destinatarioId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "lida": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "$outrosCampos": { ".validate": false }
      }
    },

    // ─────────────────────────────────────────────────────────────
    // /config
    //   • Leitura: pública (sem autenticação)
    //   • Escrita: apenas admin
    // ─────────────────────────────────────────────────────────────
    "config": {
      ".read":  true,
      ".write": "auth !== null && auth.token.admin === true",

      "versaoApp": {
        ".validate": "newData.isString() && newData.val().length <= 20"
      },
      "manutencao": {
        ".validate": "newData.isBoolean()"
      },
      "mensagemManutencao": {
        ".validate": "newData.isString() && newData.val().length <= 300"
      },
      "$outrosCampos": { ".validate": false }
    }

  }
}
